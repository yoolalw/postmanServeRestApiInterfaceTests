      "item": [
        {
          "name": "SR_UTC01 - RegisterAdmin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomNumber = Math.floor(Math.random() * 1000)\r",
                  "pm.variables.set(\"emailRegistro\", \"email_user\" + randomNumber + \"@email.com\")"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json()\r",
                  "\r",
                  "pm.test(\"Verificando retorno de status positivo (201)\", () => {\r",
                  "    pm.response.to.have.status(201)\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Headers sendo passado como Content-Type igual a JSON\", () => {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\")\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Verificando padrão de retorno do response\", () => { \r",
                  "    const schema = { \r",
                  "        \"type\": \"object\",\r",
                  "        \"required\": [\r",
                  "            \"_id\",\r",
                  "            \"message\"\r",
                  "        ],\r",
                  "        \"properties\": {\r",
                  "            \"_id\": {\r",
                  "                \"type\": \"string\"\r",
                  "            },\r",
                  "            \"message\": {\r",
                  "                \"type\": \"string\"\r",
                  "            }\r",
                  "        }\r",
                  "    }\r",
                  "\r",
                  "    pm.expect(json).to.have.jsonSchema(schema)\r",
                  "})\r",
                  "\r",
                  "const emailUserRegister = pm.variables.get(\"emailRegistro\")\r",
                  "pm.globals.set(\"emailUsuario\", emailUserRegister)\r",
                  "pm.globals.set(\"user_id\", json._id)"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"nome\": \"Fulano da Silva - Administrador\",\r\n    \"email\": \"{{emailRegistro}}\",\r\n    \"password\": \"teste\",\r\n    \"administrador\": \"true\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "response": []
        },
